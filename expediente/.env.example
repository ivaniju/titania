# Copia este fichero a .env y cárgalo con: node --env-file=.env server.js
DATABASE_URL=postgres://expediente:expediente@127.0.0.1:5432/expediente
# Al menos 16 caracteres. Genera uno con: openssl rand -base64 32
SESSION_SECRET=
PORT=3000
# console (solo desarrollo) o resend
MAIL_PROVIDER=console
MAIL_FROM=Expediente <no-reply@example.com>
# RESEND_API_KEY=
# URL pública para los enlaces de los correos
APP_URL=http://localhost:3000
# Solo para desarrollar sin HTTPS en navegadores que rechazan cookies Secure en localhost
# COOKIE_SECURE=false
